# OpenAI-совместимый сервер. LM Studio по умолчанию: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-12b-qat
# none = без "размышлений" (быстро). low/medium/high — медленнее, иногда точнее
LLM_REASONING_EFFORT=none
PORT=8787
# Модель для поиска иконок по смыслу (вкладка Embedding в LM Studio)
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
